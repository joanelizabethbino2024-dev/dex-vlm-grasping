<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="ur5e_with_robotiq">

  <!-- 1. Import the official UR5e robot macro from the system description package -->
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>

  <!-- 2. Import the Robotiq 2F-85 Gripper macro from your workspace -->
  <xacro:include filename="$(find robotiq_description)/urdf/robotiq_2f_85_macro.urdf.xacro" />

  <!-- 3. Create a world link so the robot has an anchor point -->
  <link name="world"/>

  <!-- 4. Instantiate the UR5e arm, configuring it for the simulation environment -->
  <xacro:ur_robot
    name="ur"
    tf_prefix=""
    parent="world"
    joint_limits_parameters_file="$(find ur_description)/config/ur5e/joint_limits.yaml"
    kinematics_parameters_file="$(find ur_description)/config/ur5e/default_kinematics.yaml"
    physical_parameters_file="$(find ur_description)/config/ur5e/physical_parameters.yaml"
    visual_parameters_file="$(find ur_description)/config/ur5e/visual_parameters.yaml"
    sim_ignition="true">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:ur_robot>

  <!-- 5. Attach the Gripper to the UR5e's tool0 link -->
  <xacro:robotiq_gripper
    name="RobotiqGripper"
    prefix=""
    parent="tool0"
    use_fake_hardware="false"
    sim_ignition="true">
    <origin xyz="0 0 0" rpy="0 0 1.5708"/>
  </xacro:robotiq_gripper>

  <!-- 6. Tell Gazebo to load the ros2_control simulation plugin with correct Humble naming -->
  <gazebo>
    <plugin filename="libign_ros2_control-system.so" name="ign_ros2_control::IgnitionROS2ControlPlugin">
      <parameters>$(find ur_simulation_gz)/config/ur_controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
