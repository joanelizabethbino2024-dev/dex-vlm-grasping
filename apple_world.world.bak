<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="apple_world">
    <physics name="ode_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>
    <include>
	<uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Sun</uri>
    </include>
    <include>
  	<uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Ground Plane</uri>
    </include>
    
    <include>
      <uri>model://apple_01</uri>
      <name>apple_01</name>
      <pose>0.00 0.00 0.05 0 0 0</pose>
    </include>
    <include>
      <uri>model://apple_02</uri>
      <name>apple_02</name>
      <pose>0.25 0.00 0.05 0 0 0</pose>
    </include>
    <include>
      <uri>model://apple_03</uri>
      <name>apple_03</name>
      <pose>0.50 0.00 0.05 0 0 0</pose>
    </include>
    <include>
      <uri>model://apple_04</uri>
      <name>apple_04</name>
      <pose>0.75 0.00 0.05 0 0 0</pose>
    </include>
    <include>
      <uri>model://apple_05</uri>
      <name>apple_05</name>
      <pose>1.00 0.00 0.05 0 0 0</pose>
    </include>
    <include>
      <uri>model://apple_06</uri>
      <name>apple_06</name>
      <pose>1.25 0.00 0.05 0 0 0</pose>
    </include>
    <include>
      <uri>model://apple_07</uri>
      <name>apple_07</name>
      <pose>1.50 0.00 0.05 0 0 0</pose>
    </include>
    <include>
      <uri>model://apple_08</uri>
      <name>apple_08</name>
      <pose>1.75 0.00 0.05 0 0 0</pose>
    </include>
    <include>
      <uri>model://apple_09</uri>
      <name>apple_09</name>
      <pose>2.00 0.00 0.05 0 0 0</pose>
    </include>
    <include>
      <uri>model://apple_10</uri>
      <name>apple_10</name>
      <pose>2.25 0.00 0.05 0 0 0</pose>
    </include>

    <!-- Overhead RGBD camera, centered above the apple row, looking straight down -->
    <model name="overhead_rgbd_camera">
      <static>true</static>
      <pose>1.0 0.0 1.8 0 1.5708 0</pose>
      <link name="camera_link">
        <sensor name="rgbd_camera" type="rgbd_camera">
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>
          <topic>camera</topic>
          <camera>
            <horizontal_fov>1.60</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>10.0</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
