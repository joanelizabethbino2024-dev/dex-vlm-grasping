<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ur5e_human_hand">

  <!-- ========================================================= -->
  <!-- 1. LAUNCH ARGUMENTS REQUIRED BY ur_sim_control.launch.py  -->
  <!-- ========================================================= -->
  <xacro:arg name="ur_type" default="ur5e"/>
  <xacro:arg name="name" default="ur"/>
  <xacro:arg name="tf_prefix" default=""/>
  <xacro:arg name="joint_limit_params" default="$(find ur_description)/config/$(arg ur_type)/joint_limits.yaml"/>
  <xacro:arg name="kinematics_params" default="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml"/>
  <xacro:arg name="physical_params" default="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml"/>
  <xacro:arg name="visual_params" default="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml"/>
  <xacro:arg name="transmission_hw_interface" default=""/>
  <xacro:arg name="safety_limits" default="false"/>
  <xacro:arg name="safety_pos_margin" default="0.15"/>
  <xacro:arg name="safety_k_position" default="20"/>
  <xacro:arg name="simulation_controllers" default=""/>
  <xacro:arg name="generate_ros2_control_tag" default="true"/>

  <!-- ========================================================= -->
  <!-- 2. UR5e ROBOT MACRO                                       -->
  <!-- ========================================================= -->
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>

  <link name="world"/>

  <xacro:ur_robot
    name="$(arg name)"
    tf_prefix="$(arg tf_prefix)"
    parent="world"
    joint_limits_parameters_file="$(arg joint_limit_params)"
    kinematics_parameters_file="$(arg kinematics_params)"
    physical_parameters_file="$(arg physical_params)"
    visual_parameters_file="$(arg visual_params)"
    safety_limits="$(arg safety_limits)"
    safety_pos_margin="$(arg safety_pos_margin)"
    safety_k_position="$(arg safety_k_position)"
    generate_ros2_control_tag="$(arg generate_ros2_control_tag)"
    sim_ignition="true"
  >
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:ur_robot>

  <!-- ========================================================= -->
  <!-- 3. ANGLED WRIST MOUNT (Solves Wrist Reach Limits)          -->
  <!-- ========================================================= -->
  <link name="wrist_angled_adapter">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.038" length="0.04"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.038" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="tool0_to_angled_adapter" type="fixed">
    <parent link="tool0"/>
    <child link="wrist_angled_adapter"/>
    <origin xyz="0 0 0" rpy="0 0.7854 0"/>
  </joint>

  <!-- ========================================================= -->
  <!-- 4. HUMAN PALM                                             -->
  <!-- ========================================================= -->
  <link name="hand_palm">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.09 0.08"/>
      </geometry>
      <material name="palm_black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.09 0.08"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
    </inertial>
  </link>

  <joint name="adapter_to_palm" type="fixed">
    <parent link="wrist_angled_adapter"/>
    <child link="hand_palm"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
  </joint>

  <!-- ========================================================= -->
  <!-- 5. FINGER MACRO WITH VALID GAZEBO INERTIA                 -->
  <!-- ========================================================= -->
  <xacro:macro name="human_finger" params="prefix offset_x offset_y offset_z angle_r angle_p angle_y">
    
    <link name="${prefix}_proximal">
      <visual>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.008" length="0.04"/>
        </geometry>
        <material name="skin_tone">
          <color rgba="0.85 0.65 0.5 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.008" length="0.04"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
        <mass value="0.03"/>
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
      </inertial>
    </link>

    <joint name="${prefix}_knuckle_joint" type="revolute">
      <parent link="hand_palm"/>
      <child link="${prefix}_proximal"/>
      <origin xyz="${offset_x} ${offset_y} ${offset_z}" rpy="${angle_r} ${angle_p} ${angle_y}"/>
      <axis xyz="0 1 0"/>
      <limit lower="0.0" upper="1.57" effort="5.0" velocity="3.0"/>
    </joint>

    <link name="${prefix}_distal">
      <visual>
        <origin xyz="0 0 0.015" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.006" length="0.03"/>
        </geometry>
        <material name="pad_grey">
          <color rgba="0.3 0.3 0.3 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0.015" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.006" length="0.03"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.015" rpy="0 0 0"/>
        <mass value="0.015"/>
        <inertia ixx="0.000005" ixy="0" ixz="0" iyy="0.000005" iyz="0" izz="0.000005"/>
      </inertial>
    </link>

    <joint name="${prefix}_fingertip_joint" type="revolute">
      <parent link="${prefix}_proximal"/>
      <child link="${prefix}_distal"/>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="0.0" upper="1.57" effort="3.0" velocity="3.0"/>
    </joint>

  </xacro:macro>

  <!-- Instantiate 5 Human Fingers -->
  <xacro:human_finger prefix="thumb"  offset_x="0.015" offset_y="-0.04" offset_z="0.03" angle_r="0.0" angle_p="-0.6" angle_y="-0.5"/>
  <xacro:human_finger prefix="index"  offset_x="0.0"   offset_y="-0.03" offset_z="0.08" angle_r="0.0" angle_p="0.0"  angle_y="0.0"/>
  <xacro:human_finger prefix="middle" offset_x="0.0"   offset_y="-0.01" offset_z="0.08" angle_r="0.0" angle_p="0.0"  angle_y="0.0"/>
  <xacro:human_finger prefix="ring"   offset_x="0.0"   offset_y="0.01"  offset_z="0.08" angle_r="0.0" angle_p="0.0"  angle_y="0.0"/>
  <xacro:human_finger prefix="pinky"  offset_x="0.0"   offset_y="0.03"  offset_z="0.08" angle_r="0.0" angle_p="0.0"  angle_y="0.0"/>

</robot>
