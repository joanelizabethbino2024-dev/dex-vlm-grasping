<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="sorting_workspace">

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 1. OVERHEAD CAMERA MODEL (CENTERED & RAISED TO VIEW ALL OBJECTS + BINS) -->
    <!-- 1. OVERHEAD CAMERA MODEL (WIDE ANGLE OVERHEAD VIEW) -->
    <model name="overhead_camera">
      <static>true</static>
      <!-- Centered at X=0.0, raised to Z=2.2m -->
      <pose>0.0 0.0 1.3 0 1.5708 0</pose>
      <link name="link">
        <sensor type="rgbd_camera" name="gazebo_camera">
          <always_on>true</always_on>
          <update_rate>30.0</update_rate>
          <topic>camera</topic>
          <camera>
            <horizontal_fov>1.60</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>10.0</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

    <!-- 2. THREE HOLLOW OPEN-TOP BINS -->
    <!-- GREEN BIN -->
    <model name="bin_green">
      <static>true</static>
      <pose>0.6 -0.28 0 0 0 0</pose>
      <link name="link">
        <visual name="bottom_v"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.4 0.22 0.01</size></box></geometry><material><ambient>0.1 0.4 0.1 1</ambient><diffuse>0.1 0.4 0.1 1</diffuse></material></visual>
        <collision name="bottom_c"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.4 0.22 0.01</size></box></geometry></collision>
        <visual name="front_v"><pose>0.2 0 0.05 0 0 0</pose><geometry><box><size>0.01 0.22 0.1</size></box></geometry><material><ambient>0.1 0.4 0.1 1</ambient><diffuse>0.1 0.4 0.1 1</diffuse></material></visual>
        <collision name="front_c"><pose>0.2 0 0.05 0 0 0</pose><geometry><box><size>0.01 0.22 0.1</size></box></geometry></collision>
        <visual name="back_v"><pose>-0.2 0 0.05 0 0 0</pose><geometry><box><size>0.01 0.22 0.1</size></box></geometry><material><ambient>0.1 0.4 0.1 1</ambient><diffuse>0.1 0.4 0.1 1</diffuse></material></visual>
        <collision name="back_c"><pose>-0.2 0 0.05 0 0 0</pose><geometry><box><size>0.01 0.22 0.1</size></box></geometry></collision>
        <visual name="left_v"><pose>0 0.11 0.05 0 0 0</pose><geometry><box><size>0.4 0.01 0.1</size></box></geometry><material><ambient>0.1 0.4 0.1 1</ambient><diffuse>0.1 0.4 0.1 1</diffuse></material></visual>
        <collision name="left_c"><pose>0 0.11 0.05 0 0 0</pose><geometry><box><size>0.4 0.01 0.1</size></box></geometry></collision>
        <visual name="right_v"><pose>0 -0.11 0.05 0 0 0</pose><geometry><box><size>0.4 0.01 0.1</size></box></geometry><material><ambient>0.1 0.4 0.1 1</ambient><diffuse>0.1 0.4 0.1 1</diffuse></material></visual>
        <collision name="right_c"><pose>0 -0.11 0.05 0 0 0</pose><geometry><box><size>0.4 0.01 0.1</size></box></geometry></collision>
      </link>
    </model>

    <!-- RED BIN -->
    <model name="bin_red">
      <static>true</static>
      <pose>0.6 0.0 0 0 0 0</pose>
      <link name="link">
        <visual name="bottom_v"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.4 0.22 0.01</size></box></geometry><material><ambient>0.5 0.1 0.1 1</ambient><diffuse>0.5 0.1 0.1 1</diffuse></material></visual>
        <collision name="bottom_c"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.4 0.22 0.01</size></box></geometry></collision>
        <visual name="front_v"><pose>0.2 0 0.05 0 0 0</pose><geometry><box><size>0.01 0.22 0.1</size></box></geometry><material><ambient>0.5 0.1 0.1 1</ambient><diffuse>0.5 0.1 0.1 1</diffuse></material></visual>
        <collision name="front_c"><pose>0.2 0 0.05 0 0 0</pose><geometry><box><size>0.01 0.22 0.1</size></box></geometry></collision>
        <visual name="back_v"><pose>-0.2 0 0.05 0 0 0</pose><geometry><box><size>0.01 0.22 0.1</size></box></geometry><material><ambient>0.5 0.1 0.1 1</ambient><diffuse>0.5 0.1 0.1 1</diffuse></material></visual>
        <collision name="back_c"><pose>-0.2 0 0.05 0 0 0</pose><geometry><box><size>0.01 0.22 0.1</size></box></geometry></collision>
        <visual name="left_v"><pose>0 0.11 0.05 0 0 0</pose><geometry><box><size>0.4 0.01 0.1</size></box></geometry><material><ambient>0.5 0.1 0.1 1</ambient><diffuse>0.5 0.1 0.1 1</diffuse></material></visual>
        <collision name="left_c"><pose>0 0.11 0.05 0 0 0</pose><geometry><box><size>0.4 0.01 0.1</size></box></geometry></collision>
        <visual name="right_v"><pose>0 -0.11 0.05 0 0 0</pose><geometry><box><size>0.4 0.01 0.1</size></box></geometry><material><ambient>0.5 0.1 0.1 1</ambient><diffuse>0.5 0.1 0.1 1</diffuse></material></visual>
        <collision name="right_c"><pose>0 -0.11 0.05 0 0 0</pose><geometry><box><size>0.4 0.01 0.1</size></box></geometry></collision>
      </link>
    </model>

    <!-- BLUE BIN -->
    <model name="bin_blue">
      <static>true</static>
      <pose>0.6 0.28 0 0 0 0</pose>
      <link name="link">
        <visual name="bottom_v"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.4 0.22 0.01</size></box></geometry><material><ambient>0.1 0.2 0.5 1</ambient><diffuse>0.1 0.2 0.5 1</diffuse></material></visual>
        <collision name="bottom_c"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.4 0.22 0.01</size></box></geometry></collision>
        <visual name="front_v"><pose>0.2 0 0.05 0 0 0</pose><geometry><box><size>0.01 0.22 0.1</size></box></geometry><material><ambient>0.1 0.2 0.5 1</ambient><diffuse>0.1 0.2 0.5 1</diffuse></material></visual>
        <collision name="front_c"><pose>0.2 0 0.05 0 0 0</pose><geometry><box><size>0.01 0.22 0.1</size></box></geometry></collision>
        <visual name="back_v"><pose>-0.2 0 0.05 0 0 0</pose><geometry><box><size>0.01 0.22 0.1</size></box></geometry><material><ambient>0.1 0.2 0.5 1</ambient><diffuse>0.1 0.2 0.5 1</diffuse></material></visual>
        <collision name="back_c"><pose>-0.2 0 0.05 0 0 0</pose><geometry><box><size>0.01 0.22 0.1</size></box></geometry></collision>
        <visual name="left_v"><pose>0 0.11 0.05 0 0 0</pose><geometry><box><size>0.4 0.01 0.1</size></box></geometry><material><ambient>0.1 0.2 0.5 1</ambient><diffuse>0.1 0.2 0.5 1</diffuse></material></visual>
        <collision name="left_c"><pose>0 0.11 0.05 0 0 0</pose><geometry><box><size>0.4 0.01 0.1</size></box></geometry></collision>
        <visual name="right_v"><pose>0 -0.11 0.05 0 0 0</pose><geometry><box><size>0.4 0.01 0.1</size></box></geometry><material><ambient>0.1 0.2 0.5 1</ambient><diffuse>0.1 0.2 0.5 1</diffuse></material></visual>
        <collision name="right_c"><pose>0 -0.11 0.05 0 0 0</pose><geometry><box><size>0.4 0.01 0.1</size></box></geometry></collision>
      </link>
    </model>

    <!-- 3. PICKABLE OBJECTS ON CONVEYOR -->
    <!-- Red Cube -->
    <model name="red_box">
      <pose>-0.6 -0.3 0.465 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.1</mass><inertia><ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz></inertia></inertial>
        <visual name="v"><geometry><box><size>0.07 0.07 0.08</size></box></geometry><material><ambient>1 0 0 1</ambient></material></visual>
        <collision name="c"><geometry><box><size>0.07 0.07 0.08</size></box></geometry></collision>
      </link>
    </model>

    <!-- Green Cylinder -->
    <model name="green_cylinder">
      <pose>-0.6 0.1 0.49 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.1</mass><inertia><ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz></inertia></inertial>
        <visual name="v"><geometry><cylinder><radius>0.035</radius><length>0.13</length></cylinder></geometry><material><ambient>0 1 0 1</ambient></material></visual>
        <collision name="c"><geometry><cylinder><radius>0.035</radius><length>0.13</length></cylinder></geometry></collision>
      </link>
    </model>

    <!-- Blue Sphere -->
    <model name="blue_sphere">
      <pose>-0.6 -0.1 0.465 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.1</mass><inertia><ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz></inertia></inertial>
        <visual name="v"><geometry><sphere><radius>0.04</radius></sphere></geometry><material><ambient>0 0 1 1</ambient></material></visual>
        <collision name="c"><geometry><sphere><radius>0.04</radius></sphere></geometry></collision>
      </link>
    </model>

  </world>
</sdf>
